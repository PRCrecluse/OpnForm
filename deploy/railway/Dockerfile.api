# syntax=docker/dockerfile:1
FROM php:8.3.37-fpm-bookworm@sha256:ff3db7724750bf02a3c7d65be2790feb63f6173c2fb201328eb0a2295ca32041 AS extensions
RUN apt-get update \
 && apt-get install -y --no-install-recommends libzip-dev libpng-dev libjpeg62-turbo-dev libwebp-dev libpq-dev libicu-dev \
 && docker-php-ext-configure gd --with-jpeg --with-webp \
 && docker-php-ext-install -j4 pdo_pgsql gd exif bcmath zip pcntl posix intl opcache \
 && pecl install redis-6.3.0 \
 && docker-php-ext-enable redis

FROM php:8.3.37-fpm-bookworm@sha256:ff3db7724750bf02a3c7d65be2790feb63f6173c2fb201328eb0a2295ca32041 AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl libzip4 libpng16-16 libjpeg62-turbo libwebp7 libpq5 libicu72 supervisor tini unzip \
 && curl -fsSLo /usr/share/keyrings/nginx-archive-keyring.asc https://nginx.org/keys/nginx_signing.key \
 && echo '55385da31d198fa6a5012d40ae98ecb272a6c4e8fffffba94719ffd3e87de37a  /usr/share/keyrings/nginx-archive-keyring.asc' | sha256sum -c - \
 && echo 'deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.asc] https://nginx.org/packages/debian/ bookworm nginx' > /etc/apt/sources.list.d/nginx.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends 'nginx=1.30.7-1~bookworm' \
 && rm -rf /var/lib/apt/lists/*
COPY --from=extensions /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=extensions /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
WORKDIR /app

FROM runtime AS build
COPY --from=composer:2@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac /usr/bin/composer /usr/local/bin/composer
COPY api/composer.json api/composer.lock ./
RUN COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY api/app ./app
COPY api/bootstrap ./bootstrap
COPY api/config ./config
COPY api/database ./database
COPY api/public ./public
COPY api/resources ./resources
COPY api/routes ./routes
COPY api/artisan ./artisan
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs storage/app/public bootstrap/cache \
 && COMPOSER_ALLOW_SUPERUSER=1 composer dump-autoload --no-dev --optimize \
 && composer check-platform-reqs --no-dev

FROM runtime AS production
ARG RAILWAY_GIT_COMMIT_SHA
ARG SOURCE_COMMIT
RUN printf '%s\n' "${SOURCE_COMMIT:-${RAILWAY_GIT_COMMIT_SHA:-local}}" > /app-revision
COPY --from=build --chown=www-data:www-data /app /app
COPY deploy/railway/nginx.conf /etc/nginx/nginx.conf
COPY deploy/railway/supervisord.conf /etc/opnform/supervisord.conf
COPY deploy/scaleway/health.php deploy/scaleway/scheduler.php /opt/opnform/
COPY --chmod=755 deploy/railway/api-entrypoint.sh /usr/local/bin/
RUN printf 'upload_max_filesize=100M\npost_max_size=110M\nmemory_limit=512M\nexpose_php=Off\nsession.upload_progress.enabled=0\n' > /usr/local/etc/php/conf.d/opnform-hosted.ini
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--", "api-entrypoint.sh"]
